{
    "name": "daun/statamic-tree-sync",
    "description": "Keep the trees of collections and navigations in sync across Statamic sites",
    "license": "MIT",
    "type": "statamic-addon",
    "keywords": [
        "statamic",
        "multisite",
        "structure",
        "tree",
        "navigation",
        "sync"
    ],
    "authors": [
        {
            "name": "Philipp Daun",
            "email": "post@philippdaun.net",
            "homepage": "https://philippdaun.net"
        }
    ],
    "homepage": "https://github.com/daun/statamic-tree-sync",
    "support": {
        "email": "post@philippdaun.net",
        "issues": "https://github.com/daun/statamic-tree-sync/issues",
        "source": "https://github.com/daun/statamic-tree-sync"
    },
    "require": {
        "php": "^8.3",
        "statamic/cms": "^6.40"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.14",
        "orchestra/testbench": "^10.0 || ^11.0",
        "phpunit/phpunit": "^11.0 || ^12.0 || ^13.0",
        "statamic/eloquent-driver": "^5.0"
    },
    "autoload": {
        "psr-4": {
            "Daun\\StatamicTreeSync\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Daun\\StatamicTreeSync\\Tests\\": "tests"
        }
    },
    "config": {
        "allow-plugins": {
            "pixelfear/composer-dist-plugin": true
        },
        "policy": {
            "advisories": {
                "block": true
            }
        },
        "sort-packages": true
    },
    "extra": {
        "laravel": {
            "providers": [
                "Daun\\StatamicTreeSync\\ServiceProvider"
            ]
        },
        "statamic": {
            "name": "Tree Sync",
            "description": "Keep the trees of collections and navigations in sync across sites"
        }
    },
    "scripts": {
        "analyse": "./vendor/bin/phpstan analyse --memory-limit=2G",
        "format": "./vendor/bin/pint",
        "lint": "./vendor/bin/pint --test",
        "test": "./vendor/bin/phpunit",
        "test:ci": "./vendor/bin/phpunit --coverage-clover coverage.xml",
        "test:coverage": "./vendor/bin/phpunit --coverage-text"
    }
}
